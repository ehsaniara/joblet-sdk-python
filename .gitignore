# Generated protobuf files (in root joblet/)
joblet/*_pb2.py
joblet/*_pb2_grpc.py
joblet/*.pyi
joblet/_proto_generation_info.py
# Keep proto files in joblet/proto/ - they're part of the package
!joblet/proto/
!joblet/proto/__init__.py
!joblet/proto/*_pb2.py
!joblet/proto/*_pb2_grpc.py
!joblet/proto/*.pyi

